<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions de localisation -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Notifications. Obligatoire à partir d'Android 13 : sans cette
         ligne, le système refuse d'afficher quoi que ce soit et ne
         demande jamais l'autorisation à l'utilisateur. Sur les
         versions antérieures elle est ignorée. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- usesCleartextTraffic="false" : le HTTP en clair est refusé.
         Il avait été ouvert pour le serveur de développement en
         http://10.3.20.91:8081. Laissé actif en production, il permet
         un rétrogradage — sur un wifi hostile, un attaquant force
         l'app à parler en clair et lit jetons et commandes. Les URLs
         sont en HTTPS ; ceci l'impose.

         allowBackup="false" : les données de l'app ne partent plus
         dans la sauvegarde Google Drive de l'utilisateur. Elle
         emportait le contenu de SharedPreferences, jetons compris,
         et le restaurait sur tout nouvel appareil. -->
    <application
        android:label="YAA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <!-- Clé API Google Maps (SDK Android).
             Injectée au build depuis android/secrets.properties — ne jamais
             écrire la valeur en dur ici, ce fichier est versionné. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>
        <!-- Canal par défaut des notifications reçues quand l'app est
             fermée : Android les affiche lui-même, sans passer par le
             code Dart. Sans ces deux lignes elles atterrissent dans un
             canal « Divers » que l'utilisateur peut couper sans le
             savoir. La valeur doit être identique à celle déclarée
             dans push_service.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="yaa_commandes"/>
        <!-- Icône monochrome de la barre d'état. Sans elle, Android
             affiche l'icône de l'app en blanc sur blanc, donc rien. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/couleur_notification"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sans cette déclaration, Android 11+ masque le composeur :
             canLaunchUrl('tel:…') renvoie false et le bouton Appeler
             reste sans effet, sans la moindre erreur. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Même piège pour l'e-mail et le web : sans ces deux
             déclarations, canLaunchUrl renvoie false sur Android 11+
             et les lignes « Écrire au support » et « Devenir
             coursier » ne feraient rien, silencieusement. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
