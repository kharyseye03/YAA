# Clés natives Android — NE PAS VERSIONNER le fichier secrets.properties
#
# Copier ce fichier en `secrets.properties` puis renseigner la valeur.
#
# MAPS_API_KEY : clé « Android — YAA client » du projet Google Cloud
# « YAA delivery », restreinte à :
#   - Applications Android : package gn.yaa.client + SHA-1 du keystore
#   - API : Maps SDK for Android uniquement (pas de Navigation SDK)
MAPS_API_KEY=VOTRE_CLE_ANDROID_ICI
