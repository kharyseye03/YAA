<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Manifeste appliqué aux seuls builds de debug : Gradle le
        fusionne avec le manifeste principal pendant `flutter run`, et
        l'ignore entièrement en release.

        Il existe pour une raison précise : le serveur de
        développement est en http://10.3.20.91, donc en clair. Le
        manifeste principal pose usesCleartextTraffic="false", ce qui
        fait échouer toute requête non chiffrée — protection voulue,
        qui doit rester intacte en production.

        Plutôt que de rouvrir le HTTP partout, on l'autorise ici pour
        cette seule adresse, et seulement en debug. Un build de
        publication pointé par erreur vers le serveur local ne
        fonctionnerait pas : c'est le garde-fou.
    -->
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
