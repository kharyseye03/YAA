<?xml version="1.0" encoding="utf-8"?>
<!-- Fond affiché par Android pendant le démarrage du moteur Flutter,
     avant la première frame. Couleur explicite et non ?android:colorBackground :
     en mode sombre ce dernier vaut noir, ce qui donnait un écran noir
     de près de deux secondes, indistinguable d'un plantage. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <!-- Le logo, centré, comme sur le splash Flutter qui prend le
         relais : le passage de l'un à l'autre devient invisible. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
